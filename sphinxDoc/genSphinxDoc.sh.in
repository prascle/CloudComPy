#!/usr/bin/env bash

export LD_LIBRARY_PATH=@CMAKE_INSTALL_PREFIX@/cloudComPy/plugins/CC:@CMAKE_INSTALL_PREFIX@/cloudComPy:${LD_LIBRARY_PATH}
echo "genSphinxDoc LD_LIBRARY_PATH: $LD_LIBRARY_PATH"
rm @SPHINXDOCTREES@/*.doctree
@SPHINXBUILD@ -c @CMAKE_BINARY_DIR@/sphinxDoc -b html -d @SPHINXDOCTREES@ @ALLSPHINXOPTS@ @CMAKE_INSTALL_PREFIX@/doc/html 
